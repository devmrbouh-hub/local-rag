# Скопируйте в .env при необходимости (файл .env в git не входит).

OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b-instruct-q4_K_M

# Гибрид vector + BM25 (RRF)
HYBRID_SEARCH=true
HYBRID_VECTOR_K=30
HYBRID_RRF_K=60

# Пути по умолчанию относительно корня репозитория
# DOCS_DIR=docs/tk_rf
# CHROMA_DIR=data/chroma
# BM25_DIR=data/bm25
